@page "/pacientes/{Id:guid}"
@inject DoctorPilotApiClient DoctorPilotService
<h3>PacienteDetails</h3>

@if (_paciente is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5">@_paciente.Nome</MudText>
    <MudText>@_paciente.Celular</MudText>

    @* aqui entram os botões "Iniciar Atendimento"/"Agendar Consulta" e depois o MudTabs *@


    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
        <MudTabPanel Text="Tab One">
            <MudText>Content One</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Tab Two">
            <MudText>Content Two</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Tab Three">
            <MudText>Content Three</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Tab Disabled" Disabled="true">
            <MudText>Content Disabled</MudText>
        </MudTabPanel>
    </MudTabs>
}
@code {
    [Parameter]
    public Guid Id { get; set; }
    private PacienteDetailsDto? _paciente;

    protected override async Task OnInitializedAsync()
    {
        _paciente = await DoctorPilotService.GetPacienteByIdAsync(Id);
    }
}
