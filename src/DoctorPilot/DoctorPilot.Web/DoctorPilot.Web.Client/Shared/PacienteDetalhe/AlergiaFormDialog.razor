@* Shared/PacienteDetalhe/AlergiaFormDialog.razor *@
@using DoctorPilot.Web.Client.Models

<MudDialog>
    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="Confirmar" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />

            <MudStack Spacing="3">
                <MudTextField @bind-Value="Model.NomeAlergia" Label="Nome da Alergia" For="@(() => Model.NomeAlergia)" />

                <MudSelect T="int" @bind-Value="Model.Gravidade" Label="Gravidade" Required="true">
                    @foreach (var g in Enum.GetValues<GravidadeEnum>())
                    {
                        <MudSelectItem T="int" Value="(int)g">@g.GetDisplayName()</MudSelectItem>
                    }
                </MudSelect>

                <MudDatePicker @bind-Date="Model.DataIdentificacao" Label="Data de Identificação" />

                <MudTextField @bind-Value="Model.Observacoes" Label="Observações (opcional)" Lines="3" />
            </MudStack>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4" Spacing="2">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Cancelar">Cancelar</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success">Salvar</MudButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AlergiaFormModel Model { get; set; } = new();

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    private void Confirmar()
    {
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancelar()
    {
        MudDialog.Cancel();
    }

    private void HandleInvalidSubmit()
    {
        Snackbar.Add("Preencha todos os campos obrigatórios.", Severity.Warning);
    }
}