@inject DoctorPilotApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h6">Anamneses</MudText>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AbrirNovaAnamneseAsync"
               Disabled="_abrindoDialog">
        Nova anamnese
    </MudButton>
</MudStack>

@if (_carregando)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="2" role="status" aria-live="polite">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.body2">Carregando anamneses...</MudText>
    </MudStack>
}
else if (!string.IsNullOrWhiteSpace(_erro))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_erro</MudAlert>
}
else if (_anamneses.Count == 0)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" />
        <MudText Typo="Typo.body1">Nenhuma anamnese registrada para este paciente.</MudText>
    </MudStack>
}
else
{
    <MudStack Spacing="2" aria-label="Histórico de anamneses">
        @foreach (var anamnese in _anamneses)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle1">@anamnese.NomeDaAnamnese</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @anamnese.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm", _culture)
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ChevronRight"
                               OnClick="() => AbrirDetalheAsync(anamnese.Id)">
                        Visualizar
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public Guid PacienteId { get; set; }

    [Parameter]
    public string? PacienteNome { get; set; }

    private readonly List<AnamneseItemDto> _anamneses = [];
    private readonly CultureInfo _culture = CultureInfo.GetCultureInfo("pt-BR");
    private bool _carregando = true;
    private bool _abrindoDialog;
    private string? _erro;

    protected override async Task OnInitializedAsync() => await CarregarAnamnesesAsync();

    private async Task CarregarAnamnesesAsync()
    {
        _carregando = true;
        _erro = null;

        try
        {
            var result = await ApiClient.GetAnamnesesByPacienteAsync(PacienteId);
            if (result.IsSuccess)
            {
                _anamneses.Clear();
                _anamneses.AddRange(result.Data ?? []);
            }
            else
            {
                _erro = result.Message ?? "Não foi possível carregar as anamneses do paciente.";
            }
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _erro = "Não foi possível carregar as anamneses do paciente.";
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task AbrirDetalheAsync(Guid anamneseId)
    {
        var parameters = new DialogParameters<AnamneseDetailsDialog>
        {
            { x => x.AnamneseId, anamneseId },
            { x => x.PacienteNome, PacienteNome }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<AnamneseDetailsDialog>("Detalhes da anamnese", parameters, options);
        await dialog.Result;
    }

    private async Task AbrirNovaAnamneseAsync()
    {
        _abrindoDialog = true;
        try
        {
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
            var dialog = await DialogService.ShowAsync<NovaAnamneseTipoDialog>("Nova anamnese", options);
            var result = await dialog.Result;

            if (result is not null && !result.Canceled && result.Data is string tipo)
            {
                if (tipo == NovaAnamneseTipoDialog.Manual)
                {
                    await AbrirAnamneseManualAsync();
                }
                else
                {
                    Snackbar.Add("Criação por template será implementada em uma próxima etapa.", Severity.Info);
                }
            }
        }
        finally
        {
            _abrindoDialog = false;
        }
    }

    private async Task AbrirAnamneseManualAsync()
    {
        var parameters = new DialogParameters<AnamneseManualDialog>
        {
            { x => x.PacienteId, PacienteId },
            { x => x.PacienteNome, PacienteNome }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = false,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };
        var dialog = await DialogService.ShowAsync<AnamneseManualDialog>(
            "Criar anamnese manual",
            parameters,
            options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        Snackbar.Add("Anamnese criada com sucesso.", Severity.Success);
        await CarregarAnamnesesAsync();
    }
}
