@inject DoctorPilotApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="RegistrarEvolucaoAsync"
               Disabled="_carregandoAgendamentos">
        Registrar evolução
    </MudButton>

    @if (_carregandoAgendamentos)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
    }
    else if (_agendamentosElegiveisCarregados)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" role="status" aria-live="polite">
            @TextoPendencias
        </MudText>
    }
</MudStack>

@if (_carregando)
{
    <div class="evolucoes-state" role="status" aria-live="polite">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.body2">Carregando evoluções...</MudText>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_erro))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_erro</MudAlert>
}
else if (_evolucoes.Count == 0)
{
    <div class="evolucoes-state evolucoes-empty">
        <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Size="Size.Large" />
        <MudText Typo="Typo.body1">Nenhuma evolução registrada para este paciente.</MudText>
    </div>
}
else
{
    <div class="evolucoes-list" aria-label="Histórico de evoluções">
        @foreach (var evolucao in _evolucoes)
        {
            <button type="button" class="evolucao-item" @onclick="() => AbrirEvolucaoAsync(evolucao)">
                <span class="evolucao-date">
                    <strong>@evolucao.DataHoraInicial.ToString("dd/MM/yyyy")</strong>
                    <span>@evolucao.DataHoraInicial.ToString("HH:mm")</span>
                </span>
                <span class="evolucao-main">
                    <span class="evolucao-heading">
                        <strong>@TextoOuPadrao(evolucao.Procedimento)</strong>
                        @if (EstaCancelado(evolucao))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                Cancelado
                            </MudChip>
                        }
                    </span>
                    <span class="evolucao-meta">
                        @TextoOuPadrao(evolucao.ProfissionalNome) · @FormatarTipo(evolucao.Tipo)
                    </span>
                    <span class="evolucao-preview">@ObterTrecho(evolucao.Conteudo)</span>
                </span>
                <span class="evolucao-action">
                    Ver evolução
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </span>
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Guid PacienteId { get; set; }

    [Parameter]
    public string? PacienteNome { get; set; }

    private readonly List<EvolucaoDto> _evolucoes = [];
    private readonly List<AgendamentoElegivelEvolucaoDto> _agendamentosElegiveis = [];
    private bool _carregando = true;
    private bool _carregandoAgendamentos = true;
    private bool _agendamentosElegiveisCarregados;
    private string? _erro;

    private string TextoPendencias => _agendamentosElegiveis.Count switch
    {
        0 => "Nenhuma evolução pendente.",
        1 => "1 atendimento aguardando evolução",
        var quantidade => $"{quantidade} atendimentos aguardando evolução"
    };

    protected override async Task OnInitializedAsync()
        => await Task.WhenAll(
            CarregarEvolucoesAsync(),
            CarregarAgendamentosElegiveisAsync());

    private async Task CarregarEvolucoesAsync()
    {
        _carregando = true;
        _erro = null;

        try
        {
            var result = await ApiClient.GetEvolucoesByPacienteAsync(PacienteId);
            if (result.IsSuccess)
            {
                _evolucoes.Clear();
                _evolucoes.AddRange(result.Data ?? []);
            }
            else
            {
                _erro = result.Message ?? "Não foi possível carregar as evoluções do paciente.";
            }
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _erro = "Não foi possível carregar as evoluções do paciente.";
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task AbrirEvolucaoAsync(EvolucaoDto evolucao)
    {
        var agendamento = new AgendamentoDetailsDto
        {
            Id = evolucao.AgendamentoId,
            Status = evolucao.Status,
            Tipo = evolucao.Tipo,
            Procedimento = evolucao.Procedimento,
            DataHoraInicial = evolucao.DataHoraInicial,
            DataHoraFinal = evolucao.DataHoraFinal
        };
        var parameters = new DialogParameters<EvolucaoDialog>
        {
            { x => x.Agendamento, agendamento },
            { x => x.PacienteNome, PacienteNome },
            { x => x.ProfissionalNome, evolucao.ProfissionalNome },
            { x => x.Evolucao, evolucao },
            { x => x.PermitirEdicao, !EstaCancelado(evolucao) }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = false,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };

        var dialog = await DialogService.ShowAsync<EvolucaoDialog>(
            "Evolução clínica",
            parameters,
            options);
        await dialog.Result;
        await CarregarEvolucoesAsync();
    }

    private async Task RegistrarEvolucaoAsync()
    {
        if (_carregandoAgendamentos)
            return;

        if (!_agendamentosElegiveisCarregados && !await CarregarAgendamentosElegiveisAsync(true))
            return;

        if (_agendamentosElegiveis.Count == 0)
        {
            Snackbar.Add("Não há agendamentos disponíveis para registrar evolução.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<SelecionarAgendamentoEvolucaoDialog>
        {
            { x => x.Agendamentos, _agendamentosElegiveis }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = false
        };
        var dialog = await DialogService.ShowAsync<SelecionarAgendamentoEvolucaoDialog>(
            "Registrar evolução",
            parameters,
            options);
        var selectionResult = await dialog.Result;

        if (selectionResult is null || selectionResult.Canceled ||
            selectionResult.Data is not AgendamentoElegivelEvolucaoDto agendamento)
        {
            return;
        }

        await AbrirNovaEvolucaoAsync(agendamento);
    }

    private async Task<bool> CarregarAgendamentosElegiveisAsync(bool exibirErro = false)
    {
        _carregandoAgendamentos = true;

        try
        {
            var result = await ApiClient.GetAgendamentosElegiveisParaEvolucaoAsync(PacienteId);
            if (!result.IsSuccess)
            {
                _agendamentosElegiveisCarregados = false;
                if (exibirErro)
                {
                    Snackbar.Add(
                        result.Message ?? "Não foi possível carregar os agendamentos disponíveis.",
                        Severity.Error);
                }

                return false;
            }

            _agendamentosElegiveis.Clear();
            _agendamentosElegiveis.AddRange(result.Data ?? []);
            _agendamentosElegiveisCarregados = true;
            return true;
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _agendamentosElegiveisCarregados = false;
            if (exibirErro)
                Snackbar.Add("Não foi possível carregar os agendamentos disponíveis.", Severity.Error);

            return false;
        }
        finally
        {
            _carregandoAgendamentos = false;
        }
    }

    private async Task AbrirNovaEvolucaoAsync(AgendamentoElegivelEvolucaoDto agendamentoElegivel)
    {
        var agendamento = new AgendamentoDetailsDto
        {
            Id = agendamentoElegivel.Id,
            Tipo = agendamentoElegivel.Tipo,
            Procedimento = agendamentoElegivel.Procedimento,
            DataHoraInicial = agendamentoElegivel.DataHoraInicial,
            DataHoraFinal = agendamentoElegivel.DataHoraFinal
        };
        var parameters = new DialogParameters<EvolucaoDialog>
        {
            { x => x.Agendamento, agendamento },
            { x => x.PacienteNome, PacienteNome },
            { x => x.ProfissionalNome, agendamentoElegivel.ProfissionalNome },
            { x => x.Evolucao, null }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = false,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };
        var dialog = await DialogService.ShowAsync<EvolucaoDialog>(
            "Registrar evolução",
            parameters,
            options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        Snackbar.Add("Evolução registrada com sucesso.", Severity.Success);
        await Task.WhenAll(
            CarregarEvolucoesAsync(),
            CarregarAgendamentosElegiveisAsync());
    }

    private static bool EstaCancelado(EvolucaoDto evolucao)
        => string.Equals(evolucao.Status, "cancelado", StringComparison.OrdinalIgnoreCase);

    private static string TextoOuPadrao(string? texto)
        => string.IsNullOrWhiteSpace(texto) ? "Não informado" : texto;

    private static string FormatarTipo(string? tipo)
        => string.IsNullOrWhiteSpace(tipo)
            ? "Tipo não informado"
            : CultureInfo.GetCultureInfo("pt-BR").TextInfo.ToTitleCase(tipo.Trim().ToLowerInvariant());

    private static string ObterTrecho(string? conteudo)
    {
        if (string.IsNullOrWhiteSpace(conteudo))
            return "Sem conteúdo.";

        const int limite = 180;
        var texto = string.Join(' ', conteudo.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return texto.Length <= limite ? texto : $"{texto[..limite].TrimEnd()}…";
    }
}
