@using DoctorPilot.Contracts.Pacientes
@inject NavigationManager NavigationManager

<div class="patient-information">
    <section class="information-section" aria-labelledby="basic-information-title">
        <header class="section-header">
            <div class="section-title">
                <span class="section-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                </span>
                <div>
                    <MudText Typo="Typo.h6" id="basic-information-title">Informações Básicas</MudText>
                    <MudText Typo="Typo.caption">Dados pessoais e informações de contato</MudText>
                </div>
            </div>

            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small"
                       OnClick="@(() => NavigationManager.NavigateTo($"/pacientes/{Paciente.Id}/editar"))"
                       Class="edit-registration-action">
                Editar cadastro
            </MudButton>
        </header>

        <div class="data-grid basic-data-grid">
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Nome completo</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Nome)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">E-mail</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Email)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Celular</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Celular)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Telefone</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Telefone)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Data de nascimento</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Paciente.DataNascimento.ToString("dd/MM/yyyy")</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Sexo</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Genero)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Estado civil</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.EstadoCivil)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Status</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Status)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Nome da mãe</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.NomeDaMae)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Nome do pai</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.NomeDoPai)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Profissão</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Profissao)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Necessidade especial</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.NecessidadeEspecial)</MudText>
            </div>
            <div class="data-display data-span-full">
                <MudText Typo="Typo.caption" Class="data-label">Observações</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Observacoes)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Cadastrado em</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Paciente.CreatedAt.ToString("dd/MM/yyyy HH:mm")</MudText>
            </div>
        </div>
    </section>

    <MudDivider Class="section-divider" />

    <section class="information-section" aria-labelledby="documentation-title">
        <header class="section-header">
            <div class="section-title">
                <span class="section-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                </span>
                <div>
                    <MudText Typo="Typo.h6" id="documentation-title">Documentação</MudText>
                    <MudText Typo="Typo.caption">Documentos de identificação</MudText>
                </div>
            </div>
        </header>

        <div class="data-grid documentation-data-grid">
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">CPF</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Cpf)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">RG</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Rg)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Órgão expedidor</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.OrgaoExpedidor)</MudText>
            </div>
        </div>
    </section>

    <MudDivider Class="section-divider" />

    <section class="information-section" aria-labelledby="location-title">
        <header class="section-header">
            <div class="section-title">
                <span class="section-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                </span>
                <div>
                    <MudText Typo="Typo.h6" id="location-title">Localização</MudText>
                    <MudText Typo="Typo.caption">Endereço cadastrado</MudText>
                </div>
            </div>
        </header>

        <div class="data-grid location-data-grid">
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">CEP</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.CEP)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Cidade</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Cidade)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Estado</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Estado)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Bairro</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Bairro)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Número</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Numero)</MudText>
            </div>
            <div class="data-display">
                <MudText Typo="Typo.caption" Class="data-label">Complemento</MudText>
                <MudText Typo="Typo.body1" Class="data-value">@Exibir(Paciente.Complemento)</MudText>
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public PacienteDetailsDto Paciente { get; set; } = default!;

    private static string Exibir(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "-" : valor;
}
