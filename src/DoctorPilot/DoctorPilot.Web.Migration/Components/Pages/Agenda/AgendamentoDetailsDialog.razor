@inject DoctorPilotApiClient ApiClient

<MudDialog>
    <DialogContent>
        @if (_carregando)
        {
            <div class="details-state" role="status" aria-live="polite">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2">Carregando detalhes do agendamento...</MudText>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_erro))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                @_erro
            </MudAlert>
        }
        else if (_agendamento is not null)
        {
            <div class="details-content">
                <section class="details-section" aria-labelledby="identificacao-title">
                    <div class="details-section-title">
                        <span class="details-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                        </span>
                        <MudText Typo="Typo.subtitle2" HtmlTag="h2" id="identificacao-title">Identificação</MudText>
                    </div>
                    <div class="details-grid">
                        <div class="details-field">
                            <span class="details-label">Paciente</span>
                            <span class="details-value">@NomeOuPadrao(PacienteNome)</span>
                        </div>
                        <div class="details-field">
                            <span class="details-label">Profissional</span>
                            <span class="details-value">@NomeOuPadrao(ProfissionalNome)</span>
                        </div>
                        <div class="details-field">
                            <span class="details-label">Status</span>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@CorStatus(_agendamento.Status)">
                                @FormatarStatus(_agendamento.Status)
                            </MudChip>
                        </div>
                        <div class="details-field">
                            <span class="details-label">Tipo</span>
                            <span class="details-value">@FormatarTipo(_agendamento.Tipo)</span>
                        </div>
                    </div>
                </section>

                <section class="details-section" aria-labelledby="horario-title">
                    <div class="details-section-title">
                        <span class="details-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                        </span>
                        <MudText Typo="Typo.subtitle2" HtmlTag="h2" id="horario-title">Horário</MudText>
                    </div>
                    <div class="details-grid details-grid-three">
                        <div class="details-field">
                            <span class="details-label">Data</span>
                            <span class="details-value">@_agendamento.DataHoraInicial.ToString("dd/MM/yyyy", _culture)</span>
                        </div>
                        <div class="details-field">
                            <span class="details-label">Hora inicial</span>
                            <span class="details-value">@_agendamento.DataHoraInicial.ToString("HH:mm", _culture)</span>
                        </div>
                        <div class="details-field">
                            <span class="details-label">Hora final</span>
                            <span class="details-value">@_agendamento.DataHoraFinal.ToString("HH:mm", _culture)</span>
                        </div>
                    </div>
                </section>

                <section class="details-section" aria-labelledby="atendimento-title">
                    <div class="details-section-title">
                        <span class="details-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Small" />
                        </span>
                        <MudText Typo="Typo.subtitle2" HtmlTag="h2" id="atendimento-title">Atendimento</MudText>
                    </div>
                    <div class="details-grid">
                        <div class="details-field details-field-wide">
                            <span class="details-label">Procedimento</span>
                            <span class="details-value">@_agendamento.Procedimento</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_agendamento.Sala))
                        {
                            <div class="details-field">
                                <span class="details-label">Sala</span>
                                <span class="details-value">@_agendamento.Sala</span>
                            </div>
                        }
                        <div class="details-field">
                            <span class="details-label">Confirmação</span>
                            <span class="details-value">
                                @(_agendamento.Confirmacao ? "Confirmada" : "Não confirmada")
                            </span>
                        </div>
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(_agendamento.Descricao))
                {
                    <section class="details-section" aria-labelledby="observacoes-title">
                        <div class="details-section-title">
                            <span class="details-icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" />
                            </span>
                            <MudText Typo="Typo.subtitle2" HtmlTag="h2" id="observacoes-title">Observações</MudText>
                        </div>
                        <p class="details-description">@_agendamento.Descricao</p>
                    </section>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Fechar">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly CultureInfo _culture = CultureInfo.GetCultureInfo("pt-BR");
    private AgendamentoDetailsDto? _agendamento;
    private string? _erro;
    private bool _carregando = true;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid AgendamentoId { get; set; }

    [Parameter]
    public string? PacienteNome { get; set; }

    [Parameter]
    public string? ProfissionalNome { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiClient.GetAgendamentoByIdAsync(AgendamentoId);
            if (result.IsSuccess && result.Data is not null)
            {
                _agendamento = result.Data;
            }
            else
            {
                _erro = result.Message ?? "Não foi possível carregar os detalhes do agendamento.";
            }
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _erro = "Não foi possível carregar os detalhes do agendamento.";
        }
        finally
        {
            _carregando = false;
        }
    }

    private static string NomeOuPadrao(string? nome)
        => string.IsNullOrWhiteSpace(nome) ? "Não informado" : nome;

    private static string FormatarStatus(string status)
        => Normalizar(status) switch
        {
            "agendado" => "Agendado",
            "confirmado" => "Confirmado",
            "cancelado" => "Cancelado",
            _ => FormatarTexto(status)
        };

    private static string FormatarTipo(string tipo)
        => Normalizar(tipo) switch
        {
            "consulta" => "Consulta",
            "exame" => "Exame",
            "procedimento" => "Procedimento",
            "retorno" => "Retorno",
            _ => FormatarTexto(tipo)
        };

    private static Color CorStatus(string status)
        => Normalizar(status) switch
        {
            "confirmado" => Color.Success,
            "cancelado" => Color.Error,
            "agendado" => Color.Info,
            _ => Color.Default
        };

    private static string Normalizar(string? valor)
        => valor?.Trim().ToLowerInvariant() ?? string.Empty;

    private static string FormatarTexto(string? valor)
        => string.IsNullOrWhiteSpace(valor)
            ? "Não informado"
            : CultureInfo.GetCultureInfo("pt-BR").TextInfo.ToTitleCase(valor.Trim().ToLowerInvariant());

    private void Fechar() => MudDialog.Close();
}
