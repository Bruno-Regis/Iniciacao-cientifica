@page "/agenda"
@attribute [Authorize]
@inject DoctorPilotApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Agenda</PageTitle>

<div class="agenda-page">
    <header class="agenda-header">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">Agenda</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Consulte os horários da clínica por dia, semana ou mês.
            </MudText>
        </div>

        <div class="agenda-actions">
            <MudSelect T="Guid?"
                       Label="Profissional"
                       Value="_profissionalId"
                       ValueChanged="OnProfissionalAlteradoAsync"
                       Disabled="_carregandoProfissionais"
                       Variant="Variant.Outlined"
                       Class="agenda-filter">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Todos os profissionais</MudSelectItem>
                @foreach (var profissional in _profissionais)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)profissional.Id)">@profissional.Nome</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AbrirNovoAgendamentoAsync">
                Novo Agendamento
            </MudButton>
        </div>
    </header>

    @if (_carregandoProfissionais)
    {
        <div class="agenda-filter-loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <MudText Typo="Typo.caption">Carregando profissionais...</MudText>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_erroProfissionais))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            @_erroProfissionais A agenda permanece disponível sem o filtro por profissional.
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_erroAgendamentos))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @_erroAgendamentos
        </MudAlert>
    }
    else if (_carregamentoConcluido && !_carregandoAgendamentos && _eventos.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            Nenhum agendamento encontrado no período exibido.
        </MudAlert>
    }

    <section class="agenda-scheduler" aria-busy="@_carregandoAgendamentos.ToString().ToLowerInvariant()">
        @if (_carregandoAgendamentos)
        {
            <div class="agenda-loading" role="status">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2">Carregando agendamentos...</MudText>
            </div>
        }

        <RadzenScheduler @ref="_scheduler"
                         TItem="AgendaEventModel"
                         Data="_eventos"
                         StartProperty="Inicio"
                         EndProperty="Fim"
                         TextProperty="Titulo"
                         LoadData="OnSchedulerLoadDataAsync"
                         AppointmentSelect="OnAppointmentSelectAsync"
                         AppointmentRender="OnAppointmentRender"
                         SelectedIndex="1"
                         Culture="@_culture"
                         TodayText="Hoje"
                         PrevText="Anterior"
                         NextText="Próximo">
            <Template Context="evento">
                <div class="agenda-event-content">
                    <strong>@evento.PacienteNome</strong>
                    <span>@evento.Procedimento</span>
                    <small>@evento.ProfissionalNome</small>
                </div>
            </Template>
            <ChildContent>
                <RadzenMonthView Text="Mês" />
                <RadzenWeekView Text="Semana" />
                <RadzenDayView Text="Dia" />
            </ChildContent>
        </RadzenScheduler>
    </section>
</div>

@code {
    private const int ProfissionaisPageSize = 200;

    private readonly CultureInfo _culture = CultureInfo.GetCultureInfo("pt-BR");
    private readonly List<ProfissionalItemDto> _profissionais = [];
    private List<AgendaEventModel> _eventos = [];
    private RadzenScheduler<AgendaEventModel>? _scheduler;
    private Guid? _profissionalId;
    private DateTime _inicioVisivel;
    private DateTime _fimVisivel;
    private string? _erroProfissionais;
    private string? _erroAgendamentos;
    private bool _carregandoProfissionais;
    private bool _carregandoAgendamentos;
    private bool _carregamentoConcluido;
    private bool _abrindoDetalhes;
    private int _versaoCarregamento;

    protected override async Task OnInitializedAsync()
    {
        _carregandoProfissionais = true;

        var result = await ApiClient.GetProfissionaisAsync(page: 1, pageSize: ProfissionaisPageSize);
        if (result.IsSuccess)
        {
            _profissionais.AddRange(result.Data ?? []);
        }
        else
        {
            _erroProfissionais = string.IsNullOrWhiteSpace(result.Message)
                ? "Não foi possível carregar os profissionais."
                : result.Message;
        }

        _carregandoProfissionais = false;
    }

    private async Task OnSchedulerLoadDataAsync(Radzen.SchedulerLoadDataEventArgs args)
    {
        _inicioVisivel = args.Start;
        _fimVisivel = args.End;
        await CarregarAgendamentosAsync(args.Start, args.End);
    }

    private async Task OnProfissionalAlteradoAsync(Guid? profissionalId)
    {
        _profissionalId = profissionalId;

        if (_inicioVisivel < _fimVisivel)
        {
            await CarregarAgendamentosAsync(_inicioVisivel, _fimVisivel);

            if (_scheduler is not null)
                await _scheduler.Reload();
        }
    }

    private async Task AbrirNovoAgendamentoAsync()
    {
        var inicio = ProximoHorarioPadrao();
        var modelo = new AgendamentoFormModel
        {
            ProfissionalId = _profissionalId ?? Guid.Empty,
            DataHoraInicial = inicio,
            DataHoraFinal = inicio.AddMinutes(30)
        };

        var parameters = new DialogParameters<NovoAgendamentoDialog>
        {
            { x => x.Model, modelo }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NovoAgendamentoDialog>("Novo Agendamento", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        Snackbar.Add("Agendamento criado com sucesso.", Severity.Success);

        if (_scheduler is not null)
            await _scheduler.Reload();
        else if (_inicioVisivel < _fimVisivel)
            await CarregarAgendamentosAsync(_inicioVisivel, _fimVisivel);
    }

    private async Task OnAppointmentSelectAsync(
        Radzen.SchedulerAppointmentSelectEventArgs<AgendaEventModel> args)
    {
        if (_abrindoDetalhes || args.Data is null)
            return;

        _abrindoDetalhes = true;

        try
        {
            var parameters = new DialogParameters<AgendamentoDetailsDialog>
            {
                { x => x.AgendamentoId, args.Data.Id },
                { x => x.PacienteNome, args.Data.PacienteNome },
                { x => x.ProfissionalNome, args.Data.ProfissionalNome }
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = false,
                BackdropClick = false,
                CloseOnEscapeKey = false
            };
            var dialog = await DialogService.ShowAsync<AgendamentoDetailsDialog>(
                "Detalhes do Agendamento", parameters, options);
            var result = await dialog.Result;

            if (result is { Canceled: false, Data: AgendamentoDetailsDto detalhes })
            {
                await AbrirEdicaoAsync(detalhes, args.Data.PacienteNome, args.Data.ProfissionalNome);
            }
            else if (result is { Canceled: false, Data: true })
            {
                Snackbar.Add("Agendamento cancelado com sucesso.", Severity.Success);

                if (_scheduler is not null)
                    await _scheduler.Reload();
                else if (_inicioVisivel < _fimVisivel)
                    await CarregarAgendamentosAsync(_inicioVisivel, _fimVisivel);
            }
        }
        finally
        {
            _abrindoDetalhes = false;
        }
    }

    private async Task AbrirEdicaoAsync(
        AgendamentoDetailsDto detalhes,
        string pacienteNome,
        string profissionalNome)
    {
        if (!Enum.TryParse<TipoAgendamentoFormEnum>(detalhes.Tipo, true, out var tipo))
            tipo = TipoAgendamentoFormEnum.Consulta;

        var modelo = new AgendamentoFormModel
        {
            PacienteId = detalhes.PacienteId,
            ProfissionalId = detalhes.ProfissionalId,
            Tipo = tipo,
            Procedimento = detalhes.Procedimento,
            DataHoraInicial = detalhes.DataHoraInicial,
            DataHoraFinal = detalhes.DataHoraFinal,
            Sala = detalhes.Sala,
            Confirmacao = detalhes.Confirmacao,
            Descricao = detalhes.Descricao
        };
        var parameters = new DialogParameters<NovoAgendamentoDialog>
        {
            { x => x.AgendamentoId, detalhes.Id },
            { x => x.Model, modelo },
            { x => x.PacienteIdInicial, detalhes.PacienteId },
            { x => x.PacienteNomeInicial, pacienteNome },
            { x => x.ProfissionalNomeInicial, profissionalNome }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NovoAgendamentoDialog>(
            "Editar Agendamento", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        Snackbar.Add("Agendamento atualizado com sucesso.", Severity.Success);

        if (_scheduler is not null)
            await _scheduler.Reload();
        else if (_inicioVisivel < _fimVisivel)
            await CarregarAgendamentosAsync(_inicioVisivel, _fimVisivel);
    }

    private static DateTime ProximoHorarioPadrao()
    {
        var agora = DateTime.Now;
        var minutos = agora.Minute < 30 ? 30 : 60;
        return new DateTime(agora.Year, agora.Month, agora.Day, agora.Hour, 0, 0).AddMinutes(minutos);
    }

    private async Task CarregarAgendamentosAsync(DateTime inicio, DateTime fim)
    {
        var versaoAtual = ++_versaoCarregamento;
        _carregandoAgendamentos = true;
        _carregamentoConcluido = false;
        _erroAgendamentos = null;
        await InvokeAsync(StateHasChanged);

        var result = await ApiClient.GetAgendamentosByPeriodoAsync(inicio, fim, _profissionalId);

        if (versaoAtual != _versaoCarregamento)
            return;

        if (result.IsSuccess)
        {
            _eventos = (result.Data ?? []).Select(MapearEvento).ToList();
        }
        else
        {
            _eventos = [];
            _erroAgendamentos = string.IsNullOrWhiteSpace(result.Message)
                ? "Não foi possível carregar os agendamentos."
                : result.Message;
        }

        _carregandoAgendamentos = false;
        _carregamentoConcluido = true;
    }

    private static AgendaEventModel MapearEvento(AgendamentoItemDto agendamento)
        => new()
        {
            Id = agendamento.Id,
            Titulo = $"{agendamento.PacienteNome} — {agendamento.Procedimento}",
            Inicio = agendamento.DataHoraInicial,
            Fim = agendamento.DataHoraFinal,
            PacienteId = agendamento.PacienteId,
            PacienteNome = agendamento.PacienteNome,
            ProfissionalId = agendamento.ProfissionalId,
            ProfissionalNome = agendamento.ProfissionalNome,
            Status = agendamento.Status,
            Tipo = agendamento.Tipo,
            Procedimento = agendamento.Procedimento
        };

    private static void OnAppointmentRender(Radzen.SchedulerAppointmentRenderEventArgs<AgendaEventModel> args)
    {
        if (args.Data is null)
            return;

        args.Attributes["title"] = $"{args.Data.PacienteNome} — {args.Data.Procedimento}\n{args.Data.ProfissionalNome}";

        if (string.Equals(args.Data.Status, "cancelado", StringComparison.OrdinalIgnoreCase))
            args.Attributes["style"] = "opacity: 0.62; text-decoration: line-through;";
    }
}
