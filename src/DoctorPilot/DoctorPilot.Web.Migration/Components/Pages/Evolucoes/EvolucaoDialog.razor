@inject DoctorPilotApiClient ApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Class="evolucao-content">
            <section class="evolucao-context" aria-label="Contexto do atendimento">
                <div class="evolucao-context-field">
                    <span>Paciente</span>
                    <strong>@NomeOuPadrao(PacienteNome)</strong>
                </div>
                <div class="evolucao-context-field">
                    <span>Profissional</span>
                    <strong>@NomeOuPadrao(ProfissionalNome)</strong>
                </div>
                <div class="evolucao-context-field evolucao-context-wide">
                    <span>Data e horário</span>
                    <strong>@FormatarHorario()</strong>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(_erro))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    @_erro
                </MudAlert>
            }

            @if (_modo == ModoEvolucaoDialog.Read)
            {
                <section aria-labelledby="conteudo-evolucao-title">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h2" id="conteudo-evolucao-title">
                        Evolução clínica
                    </MudText>
                    <p class="evolucao-texto">@_evolucaoAtual!.Conteudo</p>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Registrada em @_evolucaoAtual.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm", _culture)
                    </MudText>
                </section>
            }
            else
            {
                <MudForm @ref="_form">
                    <MudTextField T="string"
                                  @bind-Value="_conteudo"
                                  Label="Evolução clínica"
                                  Placeholder="Registre as informações clínicas do atendimento"
                                  Variant="Variant.Outlined"
                                  Lines="10"
                                  Required="true"
                                  RequiredError="Informe o conteúdo da evolução."
                                  MaxLength="4000"
                                  Counter="4000"
                                  Immediate="true"
                                  Disabled="_salvando" />
                </MudForm>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_modo == ModoEvolucaoDialog.Read)
        {
            @if (PermitirEdicao)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="IniciarEdicao"
                           StartIcon="@Icons.Material.Filled.Edit">
                    Editar evolução
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Fechar">
                Fechar
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="CancelarFormulario" Disabled="_salvando">
                @(_modo == ModoEvolucaoDialog.Edit ? "Cancelar edição" : "Cancelar")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync" Disabled="_salvando">
                @if (_salvando)
                {
                    <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" />
                    <span>Salvando...</span>
                }
                else
                {
                    <span>@(_modo == ModoEvolucaoDialog.Edit ? "Salvar alterações" : "Salvar")</span>
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private readonly CultureInfo _culture = CultureInfo.GetCultureInfo("pt-BR");
    private MudForm? _form;
    private string _conteudo = string.Empty;
    private string _conteudoOriginal = string.Empty;
    private string? _erro;
    private bool _salvando;
    private ModoEvolucaoDialog _modo;
    private EvolucaoDto? _evolucaoAtual;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public AgendamentoDetailsDto Agendamento { get; set; } = default!;

    [Parameter]
    public string? PacienteNome { get; set; }

    [Parameter]
    public string? ProfissionalNome { get; set; }

    [Parameter]
    public EvolucaoDto? Evolucao { get; set; }

    [Parameter]
    public bool PermitirEdicao { get; set; }

    protected override void OnInitialized()
    {
        _evolucaoAtual = Evolucao;
        _modo = Evolucao is null ? ModoEvolucaoDialog.Create : ModoEvolucaoDialog.Read;
        _conteudoOriginal = Evolucao?.Conteudo ?? string.Empty;
        _conteudo = _conteudoOriginal;
    }

    private async Task SalvarAsync()
    {
        if (_salvando || _modo == ModoEvolucaoDialog.Read || _form is null)
            return;

        await _form.ValidateAsync();
        if (!_form.IsValid || string.IsNullOrWhiteSpace(_conteudo))
            return;

        _salvando = true;
        _erro = null;

        try
        {
            var conteudo = _conteudo.Trim();
            var result = _modo == ModoEvolucaoDialog.Create
                ? await ApiClient.CreateEvolucaoAsync(Agendamento.Id, conteudo)
                : await ApiClient.UpdateEvolucaoAsync(
                    _evolucaoAtual!.Id,
                    new UpdateEvolucaoRequest { Conteudo = conteudo });

            if (result.IsSuccess)
            {
                if (_modo == ModoEvolucaoDialog.Create)
                {
                    MudDialog.Close(DialogResult.Ok(result.Data));
                    return;
                }

                _evolucaoAtual!.Conteudo = conteudo;
                _conteudoOriginal = conteudo;
                _conteudo = conteudo;
                _modo = ModoEvolucaoDialog.Read;
                Snackbar.Add("Evolução atualizada com sucesso.", Severity.Success);
                return;
            }

            _erro = result.Message ?? (_modo == ModoEvolucaoDialog.Edit
                ? "Não foi possível atualizar a evolução."
                : "Não foi possível registrar a evolução.");
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _erro = _modo == ModoEvolucaoDialog.Edit
                ? "Não foi possível atualizar a evolução."
                : "Não foi possível registrar a evolução.";
        }
        finally
        {
            _salvando = false;
        }
    }

    private string FormatarHorario()
        => $"{Agendamento.DataHoraInicial.ToString("dd/MM/yyyy HH:mm", _culture)}–{Agendamento.DataHoraFinal.ToString("HH:mm", _culture)}";

    private static string NomeOuPadrao(string? nome)
        => string.IsNullOrWhiteSpace(nome) ? "Não informado" : nome;

    private void IniciarEdicao()
    {
        if (!PermitirEdicao || _evolucaoAtual is null)
            return;

        _conteudoOriginal = _evolucaoAtual.Conteudo;
        _conteudo = _conteudoOriginal;
        _erro = null;
        _modo = ModoEvolucaoDialog.Edit;
    }

    private void CancelarFormulario()
    {
        if (_modo == ModoEvolucaoDialog.Edit)
        {
            _conteudo = _conteudoOriginal;
            _erro = null;
            _modo = ModoEvolucaoDialog.Read;
            return;
        }

        MudDialog.Cancel();
    }

    private void Fechar() => MudDialog.Close();

    private enum ModoEvolucaoDialog
    {
        Create,
        Read,
        Edit
    }
}
