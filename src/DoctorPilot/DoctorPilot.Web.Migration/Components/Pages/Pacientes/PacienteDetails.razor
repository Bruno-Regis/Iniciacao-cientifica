@page "/pacientes/{Id:guid}"
@attribute [Authorize]
@using DoctorPilot.Web.Migration.Components.Shared.PacienteDetalhe
@inject DoctorPilotApiClient DoctorPilotService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="patient-details-page">
    <nav class="patient-context" aria-label="Navegação contextual">
        <MudButton Variant="Variant.Text" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="IrParaListagem" Class="back-link">
            Pacientes
        </MudButton>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-hidden="true" />
        <MudText Typo="Typo.body2">Detalhes</MudText>
    </nav>

    @if (_paciente is null)
    {
        <div class="patient-page-state" role="status" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body2">Carregando dados do paciente...</MudText>
        </div>
    }
    else
    {
        <MudPaper Class="patient-hero" Elevation="0">
            <div class="patient-identity">
                <MudAvatar Color="Color.Primary" Size="Size.Large" Class="patient-avatar">
                    @ObterIniciais(_paciente.Nome)
                </MudAvatar>

                <div class="patient-heading">
                    <div class="patient-title-row">
                        <MudText Typo="Typo.h4" Class="patient-name">@_paciente.Nome</MudText>

                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary"
                                 Size="Size.Small" Icon="@Icons.Material.Filled.Circle"
                                 Class="patient-status">
                            @_paciente.Status
                        </MudChip>
                    </div>

                    <div class="patient-summary">
                        <span class="summary-item">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                            <span>@_paciente.Celular</span>
                        </span>
                        <span class="summary-item">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                            <span>@_paciente.Email</span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="patient-actions">
                <button type="button" class="primary-clinical-cta">
                    <span class="primary-clinical-cta__icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Small" />
                    </span>
                    Iniciar Atendimento
                </button>
                <button type="button" class="secondary-clinical-cta">
                    <span class="secondary-clinical-cta__icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                    </span>
                    Agendar Consulta
                </button>
            </div>
        </MudPaper>

        <MudPaper Class="patient-tabs-surface" Elevation="0">
            <div class="patient-tabs-shell">
                <MudTabs Elevation="0" Rounded="false"
                         ApplyEffectsToContainer="false" Color="Color.Default"
                         SliderColor="Color.Primary" TabPanelsClass="patient-tab-content">
                    <MudTabPanel Text="Informações">
                        <InformacoesTab Paciente="_paciente" />
                    </MudTabPanel>
                    <MudTabPanel Text="Alergias">
                        <AlergiasTab PacienteId="_paciente.Id" />
                    </MudTabPanel>
                    <MudTabPanel Text="Evoluções">
                        <MudText>Content Three</MudText>
                    </MudTabPanel>
                    <MudTabPanel Text="Anamnese">
                        <MudText>Alergia</MudText>
                    </MudTabPanel>
                    <MudTabPanel Text="Histórico">
                        <MudText>Content Disabled</MudText>
                    </MudTabPanel>
                    <MudTabPanel Text="Transcrições">
                        <MudText>Content Disabled</MudText>
                    </MudTabPanel>
                </MudTabs>
            </div>
        </MudPaper>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PacienteDetailsDto? _paciente;

    private void IrParaListagem() => NavigationManager.NavigateTo("/pacientes");

    protected override async Task OnInitializedAsync()
    {
        _paciente = await DoctorPilotService.GetPacienteByIdAsync(Id);
    }

    private static string ObterIniciais(string nome)
    {
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return partes.Length switch
        {
            0 => "?",
            1 => char.ToUpperInvariant(partes[0][0]).ToString(),
            _ => string.Concat(
                char.ToUpperInvariant(partes[0][0]),
                char.ToUpperInvariant(partes[^1][0]))
        };
    }
}
