@page "/agendamentos/{AgendamentoId:guid}/atendimento"
@attribute [Authorize]
@inject DoctorPilotApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Atendimento</PageTitle>

<div class="atendimento-page">
    <nav class="atendimento-context" aria-label="Navegação contextual">
        @if (_agendamento is not null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="VoltarAoPaciente" Class="context-link">
                Paciente
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="VoltarParaAgenda" Class="context-link">
                Agenda
            </MudButton>
        }
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-hidden="true" />
        <MudText Typo="Typo.body2">Atendimento</MudText>
    </nav>

    @if (_carregando)
    {
        <MudPaper Class="atendimento-state" Elevation="0" role="status" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle1">Preparando o atendimento</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Carregando os dados do agendamento...
                </MudText>
            </div>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_erro))
    {
        <MudPaper Class="atendimento-state atendimento-state-error" Elevation="0" role="alert">
            <span class="state-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
            </span>
            <div class="state-copy">
                <MudText Typo="Typo.h6" HtmlTag="h1">Não foi possível abrir o atendimento</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_erro</MudText>
            </div>
            <div class="state-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="CarregarAgendamentoAsync">
                    Tentar novamente
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="VoltarParaAgenda">
                    Voltar para a agenda
                </MudButton>
            </div>
        </MudPaper>
    }
    else if (_agendamento is not null)
    {
        <header class="atendimento-hero">
            <div class="hero-main">
                <span class="hero-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.MedicalServices" />
                </span>
                <div class="hero-copy">
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Workspace clínico</MudText>
                    <MudText Typo="Typo.h4" HtmlTag="h1">@NomeOuPadrao(_agendamento.PacienteNome)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Atendimento com @NomeOuPadrao(_agendamento.ProfissionalNome)
                    </MudText>
                </div>
            </div>

            <div class="hero-status">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@CorStatus(_agendamento.Status)">
                    @FormatarTexto(_agendamento.Status)
                </MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(_agendamento.Confirmacao ? Color.Success : Color.Warning)"
                         Icon="@(_agendamento.Confirmacao
                             ? Icons.Material.Filled.CheckCircle
                             : Icons.Material.Filled.Schedule)">
                    @(_agendamento.Confirmacao ? "Confirmado" : "Aguardando confirmação")
                </MudChip>
            </div>
        </header>

        <main class="atendimento-workspace">
            <MudPaper Class="appointment-panel" Elevation="0">
                <div class="section-heading">
                    <span class="section-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote" />
                    </span>
                    <div>
                        <MudText Typo="Typo.h6" HtmlTag="h2">Resumo do agendamento</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Contexto da consulta em andamento.
                        </MudText>
                    </div>
                </div>

                <div class="appointment-grid">
                    <div class="appointment-field">
                        <span class="field-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
                        </span>
                        <div>
                            <span class="field-label">Data</span>
                            <span class="field-value">@_agendamento.DataHoraInicial.ToString("dddd, dd 'de' MMMM 'de' yyyy", _culture)</span>
                        </div>
                    </div>
                    <div class="appointment-field">
                        <span class="field-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                        </span>
                        <div>
                            <span class="field-label">Horário</span>
                            <span class="field-value">
                                @_agendamento.DataHoraInicial.ToString("HH:mm", _culture) às @_agendamento.DataHoraFinal.ToString("HH:mm", _culture)
                            </span>
                        </div>
                    </div>
                    <div class="appointment-field">
                        <span class="field-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                        </span>
                        <div>
                            <span class="field-label">Profissional</span>
                            <span class="field-value">@NomeOuPadrao(_agendamento.ProfissionalNome)</span>
                        </div>
                    </div>
                    <div class="appointment-field">
                        <span class="field-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.MedicalInformation" Size="Size.Small" />
                        </span>
                        <div>
                            <span class="field-label">Tipo</span>
                            <span class="field-value">@FormatarTexto(_agendamento.Tipo)</span>
                        </div>
                    </div>
                    <div class="appointment-field appointment-field-wide">
                        <span class="field-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Size="Size.Small" />
                        </span>
                        <div>
                            <span class="field-label">Procedimento</span>
                            <span class="field-value">@TextoOuPadrao(_agendamento.Procedimento)</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_agendamento.Sala))
                    {
                        <div class="appointment-field">
                            <span class="field-icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Size="Size.Small" />
                            </span>
                            <div>
                                <span class="field-label">Sala</span>
                                <span class="field-value">@_agendamento.Sala</span>
                            </div>
                        </div>
                    }
                </div>
            </MudPaper>

            <MudPaper Class="transcription-panel" Elevation="0">
                <div class="transcription-content">
                    <div class="section-heading">
                        <span class="section-icon transcription-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Mic" />
                        </span>
                        <div>
                            <MudText Typo="Typo.h6" HtmlTag="h2">Transcrição da consulta</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                A gravação da consulta poderá gerar uma transcrição para apoiar a elaboração e a revisão posterior da evolução clínica.
                            </MudText>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_erroGravacao))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                            @_erroGravacao
                        </MudAlert>
                    }

                    <div class="transcription-placeholder @ClasseEstadoGravacao" aria-live="polite">
                        @if (_gravacaoDisponivel)
                        {
                            <span class="recording-result-icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                            </span>
                        }
                        else
                        {
                            <span class="audio-visual @(_gravando ? "audio-visual-active" : null)" aria-hidden="true">
                                <span></span><span></span><span></span><span></span><span></span>
                            </span>
                        }
                        <div>
                            <MudText Typo="Typo.subtitle2">@TituloEstadoGravacao</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @DescricaoEstadoGravacao
                            </MudText>
                            @if (_gravacaoDisponivel && _gravacaoTamanho > 0)
                            {
                                <MudText Typo="Typo.caption" Class="recording-metadata">
                                    @FormatarTamanho(_gravacaoTamanho)
                                    @if (!string.IsNullOrWhiteSpace(_gravacaoMimeType))
                                    {
                                        <span> • @_gravacaoMimeType</span>
                                    }
                                </MudText>
                            }
                        </div>
                    </div>
                </div>

                <div class="recording-action">
                    @if (_gravando)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Stop" Disabled="_processandoGravacao"
                                   OnClick="FinalizarGravacaoAsync">
                            @(_processandoGravacao ? "Finalizando..." : "Finalizar gravação")
                        </MudButton>
                    }
                    else if (_gravacaoDisponivel)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.TextSnippet" Disabled="true">
                            Transcrever
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Mic" Disabled="_processandoGravacao"
                                   OnClick="IniciarGravacaoAsync">
                            @(_processandoGravacao ? "Solicitando acesso..." : "Iniciar gravação")
                        </MudButton>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @TextoAuxiliarGravacao
                    </MudText>
                </div>
            </MudPaper>
        </main>
    }
</div>

@code {
    private readonly CultureInfo _culture = CultureInfo.GetCultureInfo("pt-BR");
    private AgendamentoDetailsDto? _agendamento;
    private IJSObjectReference? _recordingModule;
    private string? _erro;
    private string? _erroGravacao;
    private string? _gravacaoMimeType;
    private bool _carregando = true;
    private bool _gravando;
    private bool _gravacaoDisponivel;
    private bool _processandoGravacao;
    private long _gravacaoTamanho;

    [Parameter]
    public Guid AgendamentoId { get; set; }

    protected override Task OnParametersSetAsync() => CarregarAgendamentoAsync();

    private async Task CarregarAgendamentoAsync()
    {
        _carregando = true;
        _erro = null;
        _agendamento = null;

        try
        {
            var result = await ApiClient.GetAgendamentoByIdAsync(AgendamentoId);
            if (result.IsSuccess && result.Data is not null)
            {
                _agendamento = result.Data;
            }
            else
            {
                _erro = string.IsNullOrWhiteSpace(result.Message)
                    ? "Não foi possível carregar os dados do agendamento."
                    : result.Message;
            }
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _erro = "Não foi possível carregar os dados do agendamento. Verifique sua conexão e tente novamente.";
        }
        finally
        {
            _carregando = false;
        }
    }

    private void VoltarAoPaciente()
    {
        if (_agendamento is not null)
            NavigationManager.NavigateTo($"/pacientes/{_agendamento.PacienteId}");
    }

    private void VoltarParaAgenda() => NavigationManager.NavigateTo("/agenda");

    private string ClasseEstadoGravacao
        => _gravacaoDisponivel
            ? "transcription-placeholder-complete"
            : _gravando
                ? "transcription-placeholder-recording"
                : string.Empty;

    private string TituloEstadoGravacao
        => _gravacaoDisponivel
            ? "Gravação concluída"
            : _gravando
                ? "Gravando consulta"
                : "Gravação ainda não iniciada";

    private string DescricaoEstadoGravacao
        => _gravacaoDisponivel
            ? "O áudio foi capturado com sucesso e está mantido temporariamente no navegador."
            : _gravando
                ? "O microfone está capturando o áudio da consulta. Finalize quando encerrar."
                : "Inicie quando estiver pronto para capturar o áudio da consulta.";

    private string TextoAuxiliarGravacao
        => _gravacaoDisponivel
            ? "A transcrição será habilitada em uma próxima etapa."
            : _gravando
                ? "O indicador do navegador deve mostrar que o microfone está em uso."
                : "O navegador solicitará permissão para usar o microfone.";

    private async Task IniciarGravacaoAsync()
    {
        if (_processandoGravacao || _gravando)
            return;

        _processandoGravacao = true;
        _erroGravacao = null;
        _gravacaoDisponivel = false;
        _gravacaoTamanho = 0;
        _gravacaoMimeType = null;

        try
        {
            var module = await ObterModuloGravacaoAsync();
            await module.InvokeVoidAsync("startRecording");
            _gravando = true;
        }
        catch (JSException exception)
        {
            _erroGravacao = ObterMensagemErroMicrofone(exception);
        }
        catch (Exception exception) when (exception is TaskCanceledException or InvalidOperationException)
        {
            _erroGravacao = "Não foi possível iniciar a gravação. Tente novamente.";
        }
        finally
        {
            _processandoGravacao = false;
        }
    }

    private async Task FinalizarGravacaoAsync()
    {
        if (_processandoGravacao || !_gravando || _recordingModule is null)
            return;

        _processandoGravacao = true;
        _erroGravacao = null;

        try
        {
            var result = await _recordingModule.InvokeAsync<RecordingResult>("stopRecording");
            _gravando = false;
            _gravacaoDisponivel = result.Success && result.Size > 0;
            _gravacaoTamanho = result.Size;
            _gravacaoMimeType = result.MimeType;

            if (!_gravacaoDisponivel)
                _erroGravacao = "A gravação foi finalizada, mas nenhum áudio foi capturado. Tente novamente.";
        }
        catch (JSException)
        {
            _gravando = false;
            _gravacaoDisponivel = false;
            _erroGravacao = "Não foi possível finalizar a gravação corretamente. Tente novamente.";
        }
        catch (TaskCanceledException)
        {
            _gravando = false;
            _gravacaoDisponivel = false;
            _erroGravacao = "A finalização da gravação foi interrompida.";
        }
        finally
        {
            _processandoGravacao = false;
        }
    }

    private async Task<IJSObjectReference> ObterModuloGravacaoAsync()
    {
        _recordingModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./Components/Pages/Atendimentos/Atendimento.razor.js");

        return _recordingModule;
    }

    private static string ObterMensagemErroMicrofone(JSException exception)
    {
        if (exception.Message.Contains("NotAllowedError", StringComparison.OrdinalIgnoreCase) ||
            exception.Message.Contains("SecurityError", StringComparison.OrdinalIgnoreCase))
        {
            return "O acesso ao microfone foi negado. Autorize o microfone nas configurações do navegador e tente novamente.";
        }

        if (exception.Message.Contains("NotFoundError", StringComparison.OrdinalIgnoreCase))
            return "Nenhum microfone foi encontrado neste dispositivo.";

        if (exception.Message.Contains("NotReadableError", StringComparison.OrdinalIgnoreCase))
            return "O microfone está indisponível ou sendo usado por outro aplicativo.";

        if (exception.Message.Contains("NotSupportedError", StringComparison.OrdinalIgnoreCase))
            return "Este navegador não oferece suporte à gravação de áudio necessária.";

        return "Não foi possível acessar o microfone. Verifique as permissões do navegador e tente novamente.";
    }

    private static string FormatarTamanho(long bytes)
        => bytes < 1024
            ? $"{bytes} bytes"
            : $"{bytes / 1024d:0.0} KB";

    private static string NomeOuPadrao(string? nome)
        => string.IsNullOrWhiteSpace(nome) ? "Nome não informado" : nome;

    private static string TextoOuPadrao(string? texto)
        => string.IsNullOrWhiteSpace(texto) ? "Não informado" : texto;

    private static string FormatarTexto(string? valor)
        => string.IsNullOrWhiteSpace(valor)
            ? "Não informado"
            : CultureInfo.GetCultureInfo("pt-BR").TextInfo.ToTitleCase(valor.Trim().ToLowerInvariant());

    private static Color CorStatus(string? status)
        => status?.Trim().ToLowerInvariant() switch
        {
            "confirmado" => Color.Success,
            "cancelado" => Color.Error,
            "agendado" => Color.Info,
            _ => Color.Default
        };

    public async ValueTask DisposeAsync()
    {
        if (_recordingModule is null)
            return;

        try
        {
            await _recordingModule.InvokeVoidAsync("dispose");
        }
        catch (Exception exception) when (
            exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // O navegador encerra as tracks ao fechar a página ou desconectar o circuito.
        }

        try
        {
            await _recordingModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // O circuito já foi desconectado.
        }
    }

    private sealed class RecordingResult
    {
        public bool Success { get; set; }
        public long Size { get; set; }
        public string? MimeType { get; set; }
    }
}
