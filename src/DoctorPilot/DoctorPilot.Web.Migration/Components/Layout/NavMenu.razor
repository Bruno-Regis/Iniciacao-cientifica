<div class="nav-header">
    <a class="brand" href="/" aria-label="DoctorPilot - página inicial">
        <span class="brand-symbol" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" />
        </span>
        <span class="brand-copy">
            <MudText Typo="Typo.h6">DoctorPilot</MudText>
            <MudText Typo="Typo.caption">Clínica Inteligente</MudText>
        </span>
    </a>

    <label class="nav-toggle" for="nav-toggle" title="Alternar menu de navegação">
        <MudIcon Icon="@Icons.Material.Filled.Menu" />
    </label>
</div>

<input id="nav-toggle" type="checkbox" class="nav-toggle-input" />

<div class="nav-panel" onclick="document.getElementById('nav-toggle').checked = false">
    <div class="nav-primary">
        <MudText Class="nav-section-label" Typo="Typo.overline">Navegação</MudText>

        <MudNavMenu Class="doctorpilot-nav">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Visão geral
            </MudNavLink>
            <AuthorizeView Roles="Medico">
                <MudNavLink Href="/pacientes" Icon="@Icons.Material.Filled.Groups">
                    Pacientes
                </MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Medico">
                <MudNavLink Href="/agenda" Icon="@Icons.Material.Filled.CalendarMonth">
                    Agenda
                </MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="TenantAdmnin">
                <MudNavLink Href="/admin/profissionais" Icon="@Icons.Material.Filled.MedicalServices">
                    Profissionais
                </MudNavLink>
            </AuthorizeView >

             <MudNavLink Href="/counter" Icon="@Icons.Material.Filled.Mic">
                Transcrições
            </MudNavLink>
            <AuthorizeView Roles="Admnistrativo,Medico">
                <MudNavLink Href="/assistente-administrativo" Icon="@Icons.Material.Filled.SmartToy">
                    Assistente administrativo
                </MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="nav-footer">
                <MudDivider />
                <form method="post" action="/account/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit" class="logout-action">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                        <span>Sair</span>
                    </button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
